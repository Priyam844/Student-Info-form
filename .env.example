# Copy this file to .env and fill in your real values.
# .env is read at startup by config/settings.py (python-dotenv).

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Supabase Postgres connection string ---
# Dashboard -> Connect -> Direct (connection string) -> copy the SESSION POOLER URI
# (host *.pooler.supabase.com, port 5432). IPv4-safe and supports prepared
# statements, so it works for Django's migrations/admin/runserver.
# Avoid port 6543 (transaction pooler) - it breaks Django migrations.
# If your machine has IPv6 (or you bought the IPv4 add-on), the direct URI
# (db.YOUR_PROJECT_REF.supabase.co:5432) also works.
# URL-encode any special characters in your password (@ # ? % etc.) as %40 %23 %3F %25
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION-N.pooler.supabase.com:5432/postgres
